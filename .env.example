# AuTick - Server-side Market Data Provider Configuration
# Never expose these keys with NEXT_PUBLIC_* prefixes.

# Default Market Data Provider (options: 'bybit', 'twelvedata')
DEFAULT_DATA_PROVIDER=bybit

# Twelve Data API Key (Required only if using Twelve Data provider)
# Get a free key at: https://twelvedata.com
TWELVE_DATA_API_KEY=

# Bybit credentials (optional, Bybit linear public klines work without credentials)
BYBIT_API_KEY=
BYBIT_API_SECRET=
